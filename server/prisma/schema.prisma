// Prisma schema for Managing Furniture.
// Models follow 02-architecture-and-data-model.md › Data model.
// Other cards build on these models: change them only with team agreement.

generator client {
  // Plain JavaScript client in node_modules, imported from "@prisma/client".
  provider = "prisma-client-js"
}

datasource db {
  // The connection URL comes from prisma.config.js (DATABASE_URL).
  provider = "postgresql"
}

// ---------- Users and login ----------

enum Role {
  USER
  MODERATOR
  ADMIN
}

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique // lowercase, ends with @metropolia.fi
  name        String? // from email on first login, editable
  role        Role      @default(USER)
  active      Boolean   @default(true) // deactivated users cannot log in; never deleted
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
}

model OtpCode {
  id        Int       @id @default(autoincrement())
  email     String
  codeHash  String // bcrypt hash; never the plain code
  expiresAt DateTime // now + 10 min
  attempts  Int       @default(0) // max 5
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// ---------- Locations: campus → building → room ----------

model Campus {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  code      String     @unique // short code, e.g. KAR
  archived  Boolean    @default(false)
  buildings Building[]
}

model Building {
  id       Int     @id @default(autoincrement())
  name     String
  campusId Int
  campus   Campus  @relation(fields: [campusId], references: [id])
  archived Boolean @default(false)
  rooms    Room[]

  @@unique([campusId, name])
}

model Room {
  id           Int      @id @default(autoincrement())
  name         String // e.g. "D569"
  buildingId   Int
  building     Building @relation(fields: [buildingId], references: [id])
  qrToken      String   @unique // door QR: BASE_URL/r/<qrToken>, random, never the room name
  archived     Boolean  @default(false)
  homeItems    Item[]   @relation("HomeRoom")
  currentItems Item[]   @relation("CurrentRoom")

  @@unique([buildingId, name])
}

// ---------- Lookup lists ("+ Add new") ----------

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  code        String  @unique // short code, e.g. CHR
  autoApprove Boolean @default(false) // seed: Chair, Stool = true
  archived    Boolean @default(false)
  items       Item[]
}

model Brand {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  code     String  @unique // short code, e.g. ISK
  archived Boolean @default(false)
  items    Item[]
}

model Colour {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  code     String  @unique // short code, e.g. BLK
  archived Boolean @default(false)
  items    Item[]
}

// ---------- Items ----------

enum Condition {
  GOOD
  NEEDS_REPAIR
  BROKEN
  IN_REPAIR
  DISPOSED
}

model Item {
  id            Int       @id @default(autoincrement())
  code          String    @unique // generated by codeService; NEVER changes
  name          String // defaults to category name
  categoryId    Int
  category      Category  @relation(fields: [categoryId], references: [id])
  brandId       Int?
  brand         Brand?    @relation(fields: [brandId], references: [id])
  colourId      Int?
  colour        Colour?   @relation(fields: [colourId], references: [id])
  hasWheels     Boolean   @default(false)
  wheelCount    Int? // required 1–12 when hasWheels, else null (checked in the items API)
  notes         String?
  homeRoomId    Int
  homeRoom      Room      @relation("HomeRoom", fields: [homeRoomId], references: [id])
  currentRoomId Int
  currentRoom   Room      @relation("CurrentRoom", fields: [currentRoomId], references: [id])
  condition     Condition @default(GOOD)
  onLoan        Boolean   @default(false) // set only by the loan/return services
  createdById   Int?
  createdAt     DateTime  @default(now())
}