# Managing Furniture – environment variables
# Copy this file to .env and change the values. Never commit .env.
# Only example values here: no real Metropolia data or credentials.

# --- App ---
NODE_ENV=development
PORT=3000
# Public address of the app. QR codes on labels point here (BASE_URL/i/<code>, BASE_URL/r/<qrToken>).
BASE_URL=http://localhost:5173
TZ=Europe/Helsinki

# --- Database (PostgreSQL 16, local one from docker-compose) ---
DATABASE_URL=postgresql://mf:mf_dev_password@localhost:5432/managing_furniture?schema=public

# --- Login ---
# Signs the session cookie. Use a long random string, e.g. from: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Only emails ending with @<this domain> can log in
ALLOWED_EMAIL_DOMAIN=metropolia.fi
# Becomes ADMIN on first start or first login
INITIAL_ADMIN_EMAIL=first.admin@metropolia.fi
# How the one-time code is delivered: email | screen
# "screen" shows the code on the page and is for the demo only.
# The server refuses to start with "screen" and a Metropolia BASE_URL.
OTP_DELIVERY=email

# --- Email ---
# mailpit (local dev, inbox at http://localhost:8025) | mailgun (demo on Render) | smtp (Metropolia)
MAIL_TRANSPORT=mailpit
MAIL_FROM="Metropolia Furniture <no-reply@example.com>"

# Used when MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Used when MAIL_TRANSPORT=mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=